$
$ PHASE G0 — FREE-FLIGHT TRANSIENT MANEUVER LOADS (Step 63)
$ ============================================================
$ One MLOADS per mass case (the ABSOLUTE command tables are case-specific).
$ METHOD=-1 selects the free-flight modal solver with the internal default
$ EIGRL (all elastic modes); ZETA = 0.02 uniform elastic modal damping.
$ Integrate 0 -> 2.0 s at dt=0.01, output every 0.1 s, from the 1g TRIM 1.
MLDTRIM, 1, 1
MLDTIME, 1, 0.0, 2.0, 0.01, 0.1
MLDPRNT, 1
$ --- EMPTY: trim ELEV 0.491711 rad -> +0.1 ramp over 0.2 s, hold
MLOADS, 10, 1, 1, 11, 1, 0, -1, 0.02
MLDCOMD, 11, ELEV, 310
TABLED1, 310
+, 0.0, 0.491711, 0.2, 0.591711, 2.0, 0.591711, ENDT
$ --- HALFFUEL: trim ELEV 0.602953 rad -> +0.1 ramp over 0.2 s, hold
MLOADS, 20, 1, 1, 21, 1, 0, -1, 0.02
MLDCOMD, 21, ELEV, 320
TABLED1, 320
+, 0.0, 0.602953, 0.2, 0.702953, 2.0, 0.702953, ENDT
$ --- FULLFUEL: trim ELEV 0.714195 rad -> +0.1 ramp over 0.2 s, hold
MLOADS, 30, 1, 1, 31, 1, 0, -1, 0.02
MLDCOMD, 31, ELEV, 330
TABLED1, 330
+, 0.0, 0.714195, 0.2, 0.814195, 2.0, 0.814195, ENDT
